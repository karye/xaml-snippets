{
    "XAML label": {
        "scope": "xaml",
        "prefix": "label",
        "body": [
            "<Label>$1</Label>"
        ],
        "description": "Label element"
    },
    "XAML Button": {
        "scope": "xaml",
        "prefix": "button",
        "body": [
            "<Button Click=\"Click\" Name=\"Name\">$1</Button>"
        ],
        "description": "Button element"
    },
    "XAML TextBlock": {
        "scope": "xaml",
        "prefix": "textblock",
        "body": [
            "<TextBlock Name=\"Name\">$2</TextBlock>"
        ],
        "description": "TextBlock element"
    },
    "XAML TextBox": {
        "scope": "xaml",
        "prefix": "textbox",
        "body": [
            "<TextBox Name=\"Name\">$2</TextBox>"
        ],
        "description": "TextBox element"
    },
    "XAML CheckBox": {
        "scope": "xaml",
        "prefix": "checkbox",
        "body": [
            "<CheckBox Name=\"Name\">$2</CheckBox>"
        ],
        "description": "CheckBox element"
    },
    "XAML RadioButton": {
        "scope": "xaml",
        "prefix": "radiobutton",
        "body": [
            "<RadioButton Name=\"Name\">$2</RadioButton>"
        ],
        "description": "RadioButton element"
    },
    "XAML StackPanel": {
        "scope": "xaml",
        "prefix": "stackpanel",
        "body": [
            "<StackPanel Orientation=\"Vertical\" Margin=\"5\">",
            "\t$3",
            "</StackPanel>"
        ],
        "description": "StackPanel element"
    },
    "XAML Grid": {
        "scope": "xaml",
        "prefix": "grid",
        "body": [
            "<Grid Margin=\"5\">",
            "\t$2",
            "</Grid>"
        ],
        "description": "Grid element"
    },
    "XAML RowDefinition": {
        "scope": "xaml",
        "prefix": "rowdefinition",
        "body": [
            "<RowDefinition />"
        ],
        "description": "RowDefinition element"
    },
    "XAML ColumnDefinition": {
        "scope": "xaml",
        "prefix": "columndefinition",
        "body": [
            "<ColumnDefinition />"
        ],
        "description": "ColumnDefinition element"
    },
    "XAML Image": {
        "scope": "xaml",
        "prefix": "image",
        "body": [
            "<Image Source=\"image.png\" Name=\"Name\" />"
        ],
        "description": "Image element"
    }
